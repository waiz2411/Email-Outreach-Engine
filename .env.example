# ==============================================================================
# Outreach Engine - Environment Variables Template
# Copy to .env for local development. Never commit .env to GitHub!
# ==============================================================================

# --- Server & Environment ---
NODE_ENV=development
PORT=3001
# Public base URL (used for OAuth callbacks, tracking links, and Graph webhooks)
APP_BASE_URL=http://localhost:3001
# Comma-separated frontend origins allowed for CORS in dev (same-origin in prod)
CORS_ORIGIN=http://localhost:5173

# --- Persistent Storage (Set DATA_DIR=/var/data on Render persistent disk) ---
DATA_DIR=./data
DATABASE_PATH=./data/outreach-engine.db
# Optional explicit Prisma DATABASE_URL (defaults to file:${DATABASE_PATH})
# DATABASE_URL=file:./data/outreach-engine.db

# --- Security & Cryptography ---
# Generate 32-byte hex/base64 secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-char-random-hex-secret-do-not-use-in-production-0000
# 32-byte encryption key (64 hex chars or 32-byte base64) for OAuth tokens & WhatsApp session state
ENCRYPTION_KEY=replace-with-64-char-random-hex-encryption-key-do-not-use-in-prod-00
# Secret used to sign click/open/unsubscribe tracking tokens
TRACKING_SECRET=replace-with-64-char-random-hex-tracking-secret-do-not-use-in-prod-00
# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# --- Administrator Account ---
# Used on initial startup to seed the single administrator account if none exists.
# After first boot, you can also change the password inside Settings.
ADMIN_EMAIL=admin@example.com
# Minimum 12 characters. You may supply ADMIN_PASSWORD_HASH (scrypt format) OR ADMIN_INITIAL_PASSWORD.
ADMIN_INITIAL_PASSWORD=ReplaceWithAStrongAdminPassword123!
# ADMIN_PASSWORD_HASH=

# --- Microsoft Graph OAuth 2.0 (Azure Entra ID App Registration) ---
# Set MICROSOFT_TENANT_ID=common to support both personal Outlook and M365 accounts
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
# Must match Azure App Registration Redirect URI (e.g. https://your-app.onrender.com/api/oauth/microsoft/callback)
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/oauth/microsoft/callback

# --- Background Workers & Optional Flags ---
# Interval in ms for sending engine tick (default 5000)
SENDING_ENGINE_POLL_MS=5000
# Interval in ms for fallback inbox polling per account (default 60000)
INBOX_SYNC_POLL_MS=60000
# Set to true only in automated tests/dev to disable real external WhatsApp socket auto-reconnect
WHATSAPP_AUTO_INIT=true
